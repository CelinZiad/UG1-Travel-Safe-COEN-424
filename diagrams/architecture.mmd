flowchart TB

%% --- External Sources ---
subgraph Sources
  direction TB
  CKAN["CKAN APIs<br/>(Crimes, Accidents)"]
end

%% --- Ingestion ---
subgraph Ingestion
  direction TB
  ING["Batch Ingest<br/>(fetch_ckan_resource.py)"]
end

%% --- Storage (Data Lake) ---
subgraph "S3 Data Lake<br/>(ug1-travel-safe-bucket)"
  direction TB
  RAW["/raw"]
  REF["/ref<br/>(boroughs.geojson, WGS84)"]
  CUR["/curated<br/>(Parquet)"]
  CURA["/curated/*_areas<br/>(joined to boroughs)"]
  SRV["/served<br/>(JSON for apps/dashboards)"]
end

%% --- Processing ---
subgraph Processing
  direction TB
  EMR["EMR Serverless<br/>(Spark)"]
  JOBS["Spark Jobs<br/>Clean → Join → Aggregate"]
end

%% --- Serving/Data API ---
subgraph Serving
  direction TB
  GATE["API Gateway"]
  API["FastAPI<br/>(/areas, /areas/{id}, /areas/{id}/scores)"]
  DDB["DynamoDB<br/>(AreaScores, optional)"]
  SWG["SwaggerHub<br/>(OpenAPI 3.0)"]
end

%% --- Clients ---
subgraph Clients
  direction TB
  MAP["Web Map<br/>(Leaflet/Mapbox)"]
  GRAF["Grafana<br/>Geomaps"]
  CLI["Analysts<br/>Scripts"]
end

%% --- Flow ---
CKAN -->|HTTP GET<br/>CSV/JSON/GeoJSON| ING
ING -->|PutObject| RAW
ING -->|PutObject| REF

RAW --> EMR
REF --> EMR
EMR --> JOBS

JOBS -->|Parquet| CUR
JOBS -->|Join polygons| CURA
JOBS -->|JSON exports| SRV
JOBS -->|Upsert latest| DDB

GATE --> API
API -->|GET latest/<br/>historical| DDB
API -->|GET static JSON| SRV
SWG -.->|Publish OpenAPI| API

MAP <-->|HTTPS| GATE
GRAF -->|HTTPS read| SRV
CLI -->|S3 Select/<br/>Download| SRV
